;------------------------------------------------------------
; EchoVaultFilter.inf — registers the filter as a demand-start
; kernel service. Development-only convenience; the driver can
; also be loaded with:  fltmc load EchoVaultFilter
;------------------------------------------------------------

[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8c898bd5d53}
Provider    = %ProviderName%
DriverVer   = 08/18/2026,1.0.1.0
CatalogFile = EchoVaultFilter.cat

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall.NTamd64]
CopyFiles = DriverFiles.NTamd64

[DefaultInstall.NTamd64.Services]
AddService = EchoVaultFilter,, EchoVaultFilter_Service_Inst

[DriverFiles.NTamd64]
EchoVaultFilter.sys = 12

[EchoVaultFilter_Service_Inst]
DisplayName   = %ServiceName%
ServiceType   = 2        ; SERVICE_FILE_SYSTEM_DRIVER
StartType     = 3        ; SERVICE_DEMAND_START (fltmc load to start)
ErrorControl  = 1        ; SERVICE_ERROR_NORMAL (boot continues on failure)
ServiceBinary = %12%\EchoVaultFilter.sys
AddReg        = EchoVaultFilter_AddReg

; The altitude is REQUIRED: the filter manager cannot attach a
; minifilter to any volume without it. 360000 is the ActivityMonitor
; class range (360000-369999).
[EchoVaultFilter_AddReg]
HKR, "Instances", "DefaultInstance", 0x00000000, "EchoVaultFilter Instance"
HKR, "Instances\EchoVaultFilter Instance", "Altitude", 0x00000000, "360000"
HKR, "Instances\EchoVaultFilter Instance", "Flags", 0x00010001, 0

[Strings]
ProviderName = "EchoVault"
ServiceName  = "EchoVaultFilter"
